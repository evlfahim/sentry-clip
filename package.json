{
  "name": "sentry-clip",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, modular clipboard manager with regex-based sensitive data masking, dynamic snippets with placeholders, and robust search",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "sentry-clip": "./packages/core/dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storage": "vitest run packages/core/src/storage.test.ts",
    "test:masking": "vitest run packages/core/src/masking.test.ts",
    "test:snippets": "vitest run packages/core/src/snippets.test.ts",
    "test:history": "vitest run packages/core/src/history.test.ts",
    "test:cli": "vitest run packages/core/src/cli.test.ts",
    "vscode:test": "vitest run packages/vscode-plugin/src/extension.test.ts",
    "cli": "node packages/core/dist/cli.js",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "vscode:package": "npm run build --workspace=sentry-clip-vscode && node scripts/validate-vscode-extension.js"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
