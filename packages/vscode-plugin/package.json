{
  "name": "sentry-clip-vscode",
  "publisher": "sentry-clip",
  "version": "0.1.0",
  "displayName": "Sentry Clip",
  "description": "Secure clipboard manager with masking, snippets, and search",
  "repository": {
    "type": "git",
    "url": "https://github.com/sentry-clip/sentry-clip.git"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "vscode:test": "vitest run",
    "vscode:test-ui": "vitest run src/webview.test.ts",
    "vscode:prepublish": "npm run build",
    "vscode:test-config": "vitest run src/config.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentry-clip/core": "file:../core"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sentry-clip.showHistory",
        "title": "Sentry Clip: Show Clipboard History",
        "icon": "$(clipboard)"
      },
      {
        "command": "sentry-clip.copy",
        "title": "Sentry Clip: Copy to Clipboard"
      },
      {
        "command": "sentry-clip.pin",
        "title": "Sentry Clip: Pin/Unpin Clip"
      },
      {
        "command": "sentry-clip.search",
        "title": "Sentry Clip: Search History"
      },
      {
        "command": "sentry-clip.showSnippets",
        "title": "Sentry Clip: Show Snippets"
      },
      {
        "command": "sentry-clip.copySelection",
        "title": "Sentry Clip: Copy Selection"
      },
      {
        "command": "sentry-clip.stats",
        "title": "Sentry Clip: Show Stats"
      },
      {
        "command": "sentry-clip.clearHistory",
        "title": "Sentry Clip: Clear History"
      },
      {
        "command": "sentry-clip.quickPick",
        "title": "Sentry Clip: Quick Pick (Ctrl+Shift+V)",
        "icon": "$(paste)"
      },
      {
        "command": "sentry-clip.globalHotkey",
        "title": "Sentry Clip: Global Hotkey",
        "icon": "$(globe)"
      }
    ],
    "keybindings": [
      {
        "command": "sentry-clip.quickPick",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      },
      {
        "command": "sentry-clip.globalHotkey",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Sentry Clip",
      "properties": {
        "sentryClip.maxHistory": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of clipboard history entries to keep"
        },
        "sentryClip.enableMasking": {
          "type": "boolean",
          "default": true,
          "description": "Enable sensitive data masking"
        },
        "sentryClip.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable snippet support"
        },
        "sentryClip.exclusionPatterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns for content to exclude from clipboard history"
        },
        "sentryClip.dbPath": {
          "type": "string",
          "default": "",
          "description": "Custom SQLite database path (empty = default location)"
        }
      }
    }
  }
}
